# === Aplikasi ===
APP_ENV=development
PORT=8080

# === Keamanan (WAJIB diganti di produksi) ===
# Di APP_ENV=production, aplikasi akan GAGAL JALAN bila nilai ini masih default
# atau kurang dari 16 karakter.
JWT_SECRET=ganti-dengan-rahasia-panjang-acak-minimal-16-karakter
JWT_TTL_HOURS=12
# Kunci enkripsi nomor HP (UU PDP). Ganti di produksi!
PII_ENCRYPTION_KEY=ganti-dengan-kunci-enkripsi-acak-minimal-16

# === Hardening keamanan ===
# Origin CORS dipisah koma. Pakai "*" untuk semua (jangan di produksi).
CORS_ORIGINS=*
# Batas ukuran body request (byte). Default 1 MiB.
MAX_BODY_BYTES=1048576
# Anti brute-force login
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Set true hanya bila di belakang reverse proxy tepercaya (Nginx/Caddy).
TRUST_PROXY=false

# === Penyimpanan ===
# Kosongkan untuk in-memory (belajar). Isi untuk pakai PostgreSQL.
# Contoh lokal: postgres://postgres:postgres@localhost:5432/longsor?sslmode=disable
DATABASE_URL=

# === Sumber data BMKG ===
BMKG_BASE_URL=https://api.bmkg.go.id/publik/prakiraan-cuaca
FETCH_ENABLED=true
# Format cron: menit jam hari bulan hari-minggu
FETCH_CRON=*/30 * * * *
ALERT_CRON=*/10 * * * *

# === Ambang curah hujan (mm) ===
RAIN24_WASPADA=50
RAIN24_SIAGA=100
RAIN24_AWAS=150
RAIN72_WASPADA=80
RAIN72_SIAGA=150
RAIN72_AWAS=200

# === Notifikasi (log = belajar/gratis, live = kirim nyata) ===
NOTIFIER_MODE=log
WA_ENDPOINT=
WA_API_KEY=
SMS_PROVIDER=
SMS_API_KEY=
SMS_FROM=BMKG-JTG

# === Akun default ===
# Di produksi ADMIN_PASS wajib diganti (fail-fast).
ADMIN_USER=admin
ADMIN_PASS=admin123
